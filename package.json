{
  "name": "@agenticvalley/pqrng",
  "version": "0.1.1",
  "description": "Post-quantum-only cryptographically secure random number generator. A reseedable SP 800-90A-style DRBG built on the SHAKE256 XOF (FIPS-202) — the same Keccak sponge that underpins ML-KEM/ML-DSA — with an optional ML-KEM (FIPS-203) lattice entropy-conditioning stage. No AES-CTR-DRBG, no weak-Grover-margin primitives.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && node scripts/finalize-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "example:basic": "tsx examples/01-basic.ts",
    "example:ranges": "tsx examples/02-integers-and-choices.ts",
    "example:tokens": "tsx examples/03-tokens-uuids-and-reseeding.ts",
    "prepublishOnly": "npm run check && npm run build"
  },
  "keywords": [
    "random",
    "rng",
    "csprng",
    "drbg",
    "prng",
    "secure-random",
    "post-quantum",
    "quantum-resistant",
    "pqc",
    "shake256",
    "keccak",
    "sha3",
    "fips-202",
    "ml-kem",
    "fips-203",
    "sp800-90a",
    "entropy",
    "uuid"
  ],
  "author": "AgenticValley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agenticvalley/pqrng.git"
  },
  "homepage": "https://github.com/agenticvalley/pqrng#readme",
  "bugs": {
    "url": "https://github.com/agenticvalley/pqrng/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@noble/post-quantum": "^0.4.1",
    "@scure/base": "^1.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
