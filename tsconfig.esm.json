  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist/esm",
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts"],
